# Web Chat: copy this file to apps/web/.env.local and set your real key locally.
# Keep the real key server-side; never use a NEXT_PUBLIC_ prefix.
# The main agent currently routes its model through Vercel AI Gateway.
AI_GATEWAY_API_KEY=

# Vercel Sandbox (agent/sandbox.ts). This repo reuses project
# vercel-sandbox-default-project; local IDs live in gitignored
# `.vercel/project.json` and `.env.local` / `apps/web/.env.local`.
# Refresh OIDC with `vercel env pull` when linked, or set:
VERCEL_OIDC_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=
# On Vercel deployments these are provided automatically.

# Optional GitHub Connect for agent/extensions/git.ts.
# Without GITHUB_ORG the git extension still mounts (skills/instructions),
# but there is no authenticated `git__gh` tool.
# GITHUB_ORG=
# GITHUB_CONNECTOR=github/coding-agent

# Preview sandbox (apps/web open-lovable-style Vite preview). Defaults to vercel.
# SANDBOX_PROVIDER=vercel
